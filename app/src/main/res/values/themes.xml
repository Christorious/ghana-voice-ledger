<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Activity window theme. Compose provides the in-app theming (ui/theme/Theme.kt);
         this only needs to be a valid Material3 no-action-bar theme for the window.
         Cream status bar with dark icons so it blends edge-to-edge with the app's canvas. -->
    <style name="Theme.VoiceLedger" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#FBF6EC</item>
        <item name="android:statusBarColor">#FBF6EC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FBF6EC</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
